# ---- Next.js / browser ----
# Convex deployment URL from `npx convex dev` (https://<deployment>.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=

# Clerk (optional for public browsing; required for the admin area)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Convex deployment environment ----
# These are NOT read from .env.local by the Convex backend.
# Set them with: npx convex env set NAME value
#
# Clerk JWT issuer domain (e.g. https://your-app.clerk.accounts.dev)
CLERK_JWT_ISSUER_DOMAIN=
#
# One-time first-admin bootstrap secret. Use a long random value.
ADMIN_BOOTSTRAP_SECRET=
#
# Demo data seeding is disabled unless this is exactly "true".
ALLOW_DEMO_SEED=false
#
# Google Drive gallery sync (OAuth refresh-token flow, read-only scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: can alternatively be set in Admin -> Settings -> Drive folder ID
GOOGLE_DRIVE_FOLDER_ID=
